# Badge overlay on top of sdkconfig.defaults, applied by badge/build.sh.
# SPDX-License-Identifier: Apache-2.0 OR LGPL-2.1-or-later

# The badge partition table (two packbeam slots and an asset partition).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="badge/partitions.csv"

# ESP32-S3-MINI-1-N4R2 and other -R modules carry external PSRAM. Plain malloc
# is served from it above SPIRAM_MALLOC_ALWAYSINTERNAL; MALLOC_CAP_DMA
# allocations stay internal. IGNORE_NOTFOUND keeps modules without PSRAM booting.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Plain allocations below this come out of internal RAM, which is only ~300K
# and is also the only place FreeRTOS task stacks and DMA buffers can live.
# At 4096 the 1K chunk binaries a partition read produces landed there and
# accumulated as garbage - AtomVM's heap is in PSRAM, so nothing made it
# collect - until a websocket client could not allocate its task. At 512 the
# same happened to every refc binary a Bluesky session holds (posts, feeds,
# TLS read chunks), until handshakes stalled. 64 is where AtomVM's own heap
# binaries end, so every refc binary lives in PSRAM. At the IDF default
# (16384) the firmware boot-loops ~5 s in: "spi_master: Failed to allocate priv
# TX buffer", then abort().
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# TLS working memory lives in PSRAM. Internal RAM cannot hold it: DMA buffers
# must be internal, and a handshake under DEFAULT_MEM_ALLOC starved the LED
# driver's DMA allocation and crashed it mid-handshake. Without it, minimum
# free internal RAM fell from ~139K to ~76K (largest block 64K to 31K) and the
# first Chat visit never connected.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# libsodium's Ed25519 verification overflows the 3584-byte default main task
# stack: "A stack overflow in task main has been detected", then a reboot loop
# (a sign or verify on the scheduler is enough). nerves_hub_link_atomvm_esp32
# also ships an overlay requiring 16384. The badge configures no fwup public
# keys today, so updates do not currently exercise this.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# At -Og the VM is 99% of `factory` (17920 B spare) and slower. Assertions are
# a separate knob and stay on.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# A TLS handshake is seconds of ECC on this core, and some proxy edges will
# not wait (ngrok's https edge hangs up ~1s after its server flight, measured
# with a stalled-handshake proxy). 240MHz keeps the handshake short; the rest
# of the answer is terminating TLS somewhere without a deadline and keeping
# the chain P-256 (see avm_badge_server/priv/cert).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
